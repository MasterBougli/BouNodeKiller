<Window x:Class="NodeJsKiller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BOU NodeJS Killer"
        Width="1280"
        Height="860"
        MinWidth="1100"
        MinHeight="720"
        Background="#0B1020"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                CornerRadius="24"
                Padding="24"
                Background="#111827"
                BorderBrush="#243041"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="BOU NodeJS Killer"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Repère les processus Node, montre leur ligne de commande et permet de les fermer proprement."
                               Foreground="#C7D2FE"
                               Margin="0,8,0,0"
                               FontSize="14" />
                    <TextBlock Text="{Binding AppVersion, StringFormat=Version {0}}"
                               Foreground="#94A3B8"
                               Margin="0,6,0,0"
                               FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#E5E7EB"
                               HorizontalAlignment="Right"
                               FontSize="13" />
                    <TextBlock Text="{Binding LastScanCount, StringFormat={}{0} processus détectés}"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Right"
                               Margin="0,6,0,0"
                               FontSize="12" />
                    <Button Content="À propos"
                            Click="About_Click"
                            Margin="0,12,0,0"
                            Padding="14,8"
                            Background="#1F2937"
                            Foreground="White"
                            BorderBrush="#334155"
                            BorderThickness="1" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,16,0,16"
                CornerRadius="20"
                Padding="16"
                Background="#0F172A"
                BorderBrush="#233044"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Recherche"
                               Foreground="#94A3B8"
                               FontSize="12"
                               Margin="0,0,0,6" />
                    <Border CornerRadius="12"
                            Background="#111827"
                            BorderBrush="#263244"
                            BorderThickness="1"
                            Padding="14,10">
                        <TextBox Width="360"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="White"
                                 CaretBrush="White"
                                 FontSize="14"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="Rafraîchir"
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,10,0"
                            Padding="18,10"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold" />
                    <Button Content="Tuer la sélection"
                            Command="{Binding KillSelectedCommand}"
                            Margin="0,0,10,0"
                            Padding="18,10"
                            Background="#DC2626"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold" />
                    <Button Content="Tout tuer"
                            Command="{Binding KillAllCommand}"
                            Padding="18,10"
                            Background="#B45309"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                CornerRadius="20"
                Background="#0F172A"
                BorderBrush="#233044"
                BorderThickness="1"
                Padding="12">
            <DataGrid ItemsSource="{Binding ProcessesView}"
                      SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="White"
                      RowBackground="#111827"
                      AlternatingRowBackground="#0B1220"
                      RowHeaderWidth="0"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#162033" />
                        <Setter Property="Foreground" Value="#CBD5E1" />
                        <Setter Property="BorderBrush" Value="#233044" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="12,10" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="10,8" />
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="90" />
                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="120" />
                    <DataGridTextColumn Header="Script / cible" Binding="{Binding ExecutionTarget}" Width="220" />
                    <DataGridTextColumn Header="Répertoire lancement" Binding="{Binding ShortWorkingDirectory}" Width="260" />
                    <DataGridTextColumn Header="Utilisateur" Binding="{Binding Owner}" Width="160" />
                    <DataGridTextColumn Header="Démarré" Binding="{Binding StartedAtDisplay}" Width="170" />
                    <DataGridTextColumn Header="Parent PID" Binding="{Binding ParentProcessId}" Width="100" />
                    <DataGridTextColumn Header="Commande" Binding="{Binding ShortCommandLine}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,16,0,0"
                CornerRadius="16"
                Padding="14"
                Background="#111827"
                BorderBrush="#233044"
                BorderThickness="1">
            <DockPanel>
                <TextBlock Text="Astuce : trie par PID ou cherche un nom de script pour retrouver vite un processus précis."
                           Foreground="#CBD5E1"
                           DockPanel.Dock="Left" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#94A3B8"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
